{
  "displayName": "Simple Object Manager (Som)",
  "name": "som",
  "platform": "web",
  "version": "1.0.1",
  "description": "Simple Object Manager JavaScript framework. Provide an easy way to manipulate objects via simple methods and avoid dealing with complex nested structure via difficult functions",
  "author": {
    "name": "Julien Piccini",
    "url": "http://www.datanalyst.info",
    "email": "piccini.julien@gmail.com"
  },
  "viewBasePath": "src/view/",
  "main": "src/lib/main.js",
  "configuration": {
    "viewPath": "configuration/configuration.html",
    "schema": {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "type": "object",
      "properties": {
        "myObjects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "iconPath": "resources/icons/icon.svg",
  "sharedModules": [
    {
      "name": "som",
      "libPath": "src/lib/sharedModules/som.js"
    }
  ]
}
